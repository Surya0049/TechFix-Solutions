<Window
    x:Class="TechFixRecoveryAI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="TechFix Recovery AI"
    Width="1440"
    Height="900">

    <Grid Background="#111111">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1A1A1A">
            <StackPanel Margin="20">

                <TextBlock
                    Text="TechFix Solutions"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="White"
                    Margin="0,10,0,30"/>

                <Button Content="Dashboard" Height="48" Margin="0,6"/>
                <Button Content="AI Diagnostics" Height="48" Margin="0,6"/>
                <Button Content="Recovery Center" Height="48" Margin="0,6"/>
                <Button Content="Rollback Manager" Height="48" Margin="0,6"/>
                <Button Content="Deployment Center" Height="48" Margin="0,6"/>
                <Button Content="Data Recovery" Height="48" Margin="0,6"/>
                <Button Content="Driver Intelligence" Height="48" Margin="0,6"/>
                <Button Content="Live System Health" Height="48" Margin="0,6"/>

            </StackPanel>
        </Border>

        <Grid Grid.Column="1" Margin="20">

            <Grid.RowDefinitions>
                <RowDefinition Height="90"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Background="#1E1E1E" CornerRadius="12" Padding="20">
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Text="Recovery Dashboard"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="White"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1" Margin="0,20,0,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Grid.Column="0" Margin="10" Background="#1E1E1E" CornerRadius="12">
                    <StackPanel Margin="20">
                        <TextBlock Text="Detected Systems" FontSize="24" Foreground="White"/>
                        <TextBlock Text="Windows 11 Pro Detected" Margin="0,20,0,0" Foreground="#BDBDBD"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="0" Grid.Column="1" Margin="10" Background="#1E1E1E" CornerRadius="12">
                    <StackPanel Margin="20">
                        <TextBlock Text="AI Repair Status" FontSize="24" Foreground="White"/>
                        <TextBlock Text="Repair Confidence: 94%" Margin="0,20,0,0" Foreground="#BDBDBD"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="0" Margin="10" Background="#1E1E1E" CornerRadius="12">
                    <StackPanel Margin="20">
                        <TextBlock Text="Recovery Operations" FontSize="24" Foreground="White"/>
                        <Button Content="Start Intelligent Repair" Height="52" Margin="0,20,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Margin="10" Background="#1E1E1E" CornerRadius="12">
                    <StackPanel Margin="20">
                        <TextBlock Text="Live Diagnostics" FontSize="24" Foreground="White"/>
                        <TextBlock Text="Monitoring active..." Margin="0,20,0,0" Foreground="#BDBDBD"/>
                    </StackPanel>
                </Border>

            </Grid>

        </Grid>

    </Grid>

</Window>
